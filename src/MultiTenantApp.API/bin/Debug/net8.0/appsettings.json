{
  "ConnectionStrings": {
    "MasterConnection": "Server=localhost;Database=MultiTenantMaster;Trusted_Connection=true;TrustServerCertificate=true;",
    "TenantTemplateSql": "Server={Server};Database={Database};User Id={UserId};Password={Password};TrustServerCertificate=true;",
    "TenantTemplateWindows": "Server={Server};Database={Database};Trusted_Connection=true;TrustServerCertificate=true;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}